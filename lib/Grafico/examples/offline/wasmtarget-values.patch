+function _emit_float_egal!(bld, ctx, wt)
+    temporary = allocate_local!(ctx, wt)
+    local_set!(bld, temporary)
+    reinterpret = wt === F64 ? Opcode.I64_REINTERPRET_F64 : Opcode.I32_REINTERPRET_F32
+    num!(bld, reinterpret)
+    local_get!(bld, temporary)
+    num!(bld, reinterpret)
+    num!(bld, wt === F64 ? Opcode.I64_EQ : Opcode.I32_EQ)
+    return nothing
+end
+
+function _emit_fixed_tuple_egal!(bld, ctx, T)
+    info = ctx.type_registry.structs[T]
+    wt = ConcreteRef(info.wasm_type_idx, true)
+    second = allocate_local!(ctx, wt)
+    first = allocate_local!(ctx, wt)
+    local_set!(bld, second)
+    local_set!(bld, first)
+    for (index, F) in enumerate(fieldtypes(T))
+        fwt = get_concrete_wasm_type(F, ctx.mod, ctx.type_registry)
+        local_get!(bld, first)
+        struct_get!(bld, info.wasm_type_idx, wasm_field_idx(info, index), fwt)
+        local_get!(bld, second)
+        struct_get!(bld, info.wasm_type_idx, wasm_field_idx(info, index), fwt)
+        if F <: Tuple
+            _emit_fixed_tuple_egal!(bld, ctx, F)
+        elseif fwt === F64 || fwt === F32
+            _emit_float_egal!(bld, ctx, fwt)
+        elseif fwt === I64
+            num!(bld, Opcode.I64_EQ)
+        elseif fwt === I32
+            num!(bld, Opcode.I32_EQ)
+        else
+            num!(bld, Opcode.REF_EQ)
+        end
+        index > 1 && num!(bld, Opcode.I32_AND)
+    end
+    fieldcount(T) == 0 && i32_const!(bld, 1)
+    return nothing
+end
