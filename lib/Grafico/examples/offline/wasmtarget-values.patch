+# Fixed tuple identity follows Julia's field identity, not the allocation of
+# the WasmGC tuple container. Keep mutable fields (notably arrays) as refs.
+function _has_fixed_tuple_egal(T)
+    T isa DataType && T <: Tuple && isconcretetype(T) || return false
+    all(fieldtypes(T)) do F
+        F <: Tuple ? _has_fixed_tuple_egal(F) :
+            (isprimitivetype(F) && sizeof(F) <= 8) || (isconcretetype(F) && ismutabletype(F) && F !== String)
+    end
+end
