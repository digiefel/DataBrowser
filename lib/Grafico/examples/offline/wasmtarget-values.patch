 # TRIM_SAFE verifier is materially stronger on 1.13 (1.12 inference leaves
 # dead empty-reduce branches dynamic); collection itself (TRIM_UNSAFE
 # semantics — what this function does) works on both.
+
+# A method's static parameters come from dispatch intersection. Manufacturing
+# a MethodInstance with an empty environment corrupts parametric callees during
+# inlining, even when its printed argument signature looks correct.
+function _specialize_bound_method(method, signature)
+    table = CC.OverlayMethodTable(Base.get_world_counter(), WASM_METHOD_TABLE)
+    matches = CC.findall(signature, table; limit = -1)
+    (matches === nothing || isempty(matches)) && error("No closed-world method match for $signature")
+    selected = first(matches)
+    for match in matches
+        if match.method === method
+            selected = match
+            break
+        end
+    end
+    CC.specialize_method(selected)
+end
 
