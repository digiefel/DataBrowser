+# Native arrays of immutable structs have an element stride too. WasmGC
+# stores each immutable value in one typed array slot, so copying complete
+# elements uses array.copy after scaling native byte offsets by that stride.
+function _memmove_storage_eltypes(ctx::AbstractCompilationContext)
+    elements = Set{DataType}((Int8,UInt8,Int16,UInt16,Int32,UInt32,Int64,UInt64,Float32,Float64))
+    for T in Iterators.flatten((values(ctx.ssa_types), ctx.code_info.slottypes))
+        T isa DataType || continue
+        element = if T.name.name in (:GenericMemory, :GenericMemoryRef) && length(T.parameters) >= 2
+            T.parameters[2]
+        elseif T <: AbstractArray
+            eltype(T)
+        else
+            nothing
+        end
+        element isa DataType && isbitstype(element) && sizeof(element) > 0 || continue
+        push!(elements, element)
+    end
+    elements
 end
 
